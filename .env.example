# Model provider API keys. The names must match api_key_env in config.yaml.
OPENBOT_MODEL_API_KEY=xxxxx
OPENBOT_EMBEDDING_API_KEY=xxxxx

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Feishu app credentials
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=xxxxx
FEISHU_VERIFICATION_TOKEN=xxxxx
FEISHU_ENCRYPT_KEY=xxxxx

# Search tool (Tavily)
TAVILY_API_KEY=tvly-xxxxx

# Reranker provider key. The name must match reranker.api_key_env in config.yaml.
OPENBOT_RERANKER_API_KEY=sk-xxxxx
